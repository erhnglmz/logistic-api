# PostgreSQL (docker compose + local)
POSTGRES_DB=logistic
POSTGRES_USER=appuser
POSTGRES_PASSWORD=logistic_dev
POSTGRES_PORT=5432

# Optional: sibling folder name for logistic-web when not using ../logistic-web
# LOGISTIC_WEB_PATH=../logistic-web

# API connection (host machine / dotnet run)
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=logistic;Username=appuser;Password=logistic_dev

# Docker compose: API container uses Host=postgres instead (set in compose.yaml)